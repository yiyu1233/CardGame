; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="卡牌游戏框架"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

CardDB="*res://scripts/CardDatabase.gd"
AdminAuth="*res://scripts/AdminAuth.gd"
GameManager="*res://scripts/GameManager.gd"
GameTracker="*res://scripts/GameTracker.gd"
GameSettings="*res://scripts/GameSettings.gd"
SoundFx="*res://scripts/SoundFx.gd"
Voice="*res://scripts/CardVoice.gd"
Net="*res://scripts/NetSession.gd"
Mods="*res://scripts/ModLoader.gd"
AiConfig="*res://scripts/AiConfig.gd"
AiAssistant="*res://scripts/AiAssistant.gd"
[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1180
window/size/min_height=860

[gui]

theme/custom_font="res://theme/default_font.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
